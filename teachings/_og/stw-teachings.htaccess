<IfModule mod_headers.c>
  Header set Cache-Control "no-cache, must-revalidate"
  Header set Pragma "no-cache"
</IfModule>

# BEGIN StayTheWay share cards — every teaching page gets its own og:image (see _og/README.md)
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /stw-teachings/
RewriteRule ^_og/ - [L]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^(.+\.html)$ _og/page.php?f=$1 [L]
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+)/$ _og/page.php?f=$1/index.html [L]
</IfModule>
# END StayTheWay share cards
